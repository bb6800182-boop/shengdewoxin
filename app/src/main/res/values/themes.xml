<?xml version="1.0" encoding="utf-8"?>
<!-- 淺色主題；深色在 values-night/themes.xml。設定頁的「外觀」可以固定淺色或深色 -->
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:colorAccent">@color/accent_text</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_subtle</item>
        <item name="android:textColorHint">@color/ink_subtle</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
